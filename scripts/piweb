#!/bin/bash
# piweb — one command to manage the pi-web server.
#
#   piweb            status (default)
#   piweb restart    restart it safely
#   piweb stop       stop it (won't come back until `piweb start`)
#   piweb start      start it
#   piweb logs       follow the server log
#   piweb open       open it in a browser
#   piweb amihosted   am I running inside the server? (restart guard)
#
# Why this exists: the server is managed by launchd + a supervisor loop, so
# "just kill it and start it again" is the one thing that does NOT work — killing
# the server from inside a pi-web session kills the session too, and a hand-run
# `npm run dev` gets killed by the supervisor that owns the port.
#
# The supervisor sources ~/.pi-web.env, so it is also what applies the password.
# `piweb stop` followed by a hand-run server therefore means NO AUTH.
#
# `piweb restart` REFUSES to run when invoked from inside the server itself.
# An agent hosted by pi-web is a child of next-server, so restarting kills the
# session mid-response — which happened twice before this guard existed.
# Override deliberately with: piweb restart --force

set -uo pipefail

LABEL="com.dhavalrana.piweb"
DOMAIN="gui/$(id -u)"
TARGET="$DOMAIN/$LABEL"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
PORT="${PIWEB_PORT:-30141}"
REPO="${PIWEB_APP_DIR:-$HOME/projects/pi-web}"
ENV_FILE="${PIWEB_ENV_FILE:-$HOME/.pi-web.env}"

c_ok=$'\033[32m'; c_bad=$'\033[31m'; c_dim=$'\033[2m'; c_off=$'\033[0m'
[ -t 1 ] || { c_ok=; c_bad=; c_dim=; c_off=; }

# Source the secrets once, the same way the supervisor does. Doing it inside the
# status function instead meant the password check ran in a subshell whose output
# was not captured, so "with password" always reported blank.
PI_WEB_PASSWORD=""
PI_WEB_ALLOWED_HOSTS=""
if [ -f "$ENV_FILE" ]; then
  set -a
  # shellcheck disable=SC1090
  . "$ENV_FILE"
  set +a
fi

running() { launchctl print "$TARGET" >/dev/null 2>&1; }

# PIDs of scheduled-restart sleepers.
#
# Must be precise. A loose grep for the label also matches any shell whose
# command line mentions it — including the one running this script — which made
# 'pending' report a phantom entry and 'cancel' target its own caller.
# The sleeper's command is exactly: <...>/Python - <label> <uid> <delay>
sleeper_pids() {
  # shellcheck disable=SC2009
  ps -eo pid=,command= | grep -E '/Python - com\.dhavalrana\.piweb [0-9]+ [0-9]+$' | awk '{print $1}'
}
pid_of()  { launchctl list 2>/dev/null | awk -v l="$LABEL" '$3==l {print $1}'; }
port_pid(){ lsof -tnP -iTCP:"$PORT" -sTCP:LISTEN 2>/dev/null | head -1; }

# Are we running INSIDE the server we are being asked to manage?
#
# This is not hypothetical. An agent hosted by pi-web runs as a child of
# next-server, so `piweb restart` kills the process tree containing the agent —
# mid-response, before it can say what happened. That has now happened twice
# (2026-09-27, both times leaving the user with a dead server and no explanation).
#
# Detecting it makes the failure impossible instead of something to remember.
hosted_by_server() {
  local server p
  server="$(port_pid)"
  [ -z "$server" ] && return 1
  p=$$
  local i
  for i in $(seq 1 20); do
    p="$(ps -o ppid= -p "$p" 2>/dev/null | tr -d ' ')"
    case "$p" in ''|0|1) return 1 ;; esac
    [ "$p" = "$server" ] && return 0
  done
  return 1
}

# Refuse when the requested verb would kill the server hosting this shell.
#
# Applied to EVERY verb that stops the server, not just restart: `stop` boots the
# launchd job out, which kills the same process tree. Guarding only `restart`
# left an identical hole one command over.
refuse_if_hosted() {
  local verb="$1" override="${2:-}"
  [ "$override" = "--force" ] && return 0
  hosted_by_server || return 0
  cat <<MSG

  '$verb' would kill the process tree this session lives in.

  This shell is running INSIDE pi-web (a child of next-server pid $(port_pid)).
  Running '$verb' inline kills the server mid-response, so it looks like the
  command failed and you are left with a dead server and no explanation. That
  has happened twice.

  Three ways forward, in order of preference:

    1. Ask the user first, then schedule it so this reply gets delivered:

           piweb restart --in 20

       Detached: waits 20s, THEN restarts. The conversation drops as announced
       and resumes when the server is back. Use this when the user is on a
       phone and cannot open a terminal.

    2. Run it from a normal Terminal window (not under the server):

           piweb $verb

    3. Kill this session too, deliberately:

           piweb $verb --force

MSG
  return 1
}

# Detached restart after a delay, so a hosted agent can announce it and finish
# replying before the process tree goes away. Double-fork + setsid: the sleeper
# must not be a child of the server, or it dies with the thing it is restarting.
schedule_restart() {
  local delay="$1"
  python3 - "$LABEL" "$(id -u)" "$delay" >/dev/null 2>&1 <<'PY' &
import os, sys, time
label, uid, delay = sys.argv[1], sys.argv[2], float(sys.argv[3])
if os.fork() != 0:
    os._exit(0)
os.setsid()
if os.fork() != 0:
    os._exit(0)
time.sleep(delay)
os.execvp("launchctl", ["launchctl", "kickstart", "-k", f"gui/{uid}/{label}"])
PY
  disown 2>/dev/null || true
}

status() {
  printf '\n  pi-web\n'
  if running; then
    printf '    state   %srunning%s  (launchd pid %s)\n' "$c_ok" "$c_off" "$(pid_of)"
  else
    printf '    state   %sstopped%s\n' "$c_bad" "$c_off"
  fi

  local pp; pp="$(port_pid)"
  if [ -n "$pp" ]; then
    printf '    port    %s  (pid %s)\n' "$PORT" "$pp"
  else
    printf '    port    %s  %snothing listening%s\n' "$PORT" "$c_bad" "$c_off"
  fi

  # Auth is the whole point of the supervisor, so report it, not just liveness.
  if [ -n "$pp" ]; then
    local an au
    an="$(curl -s -o /dev/null -w '%{http_code}' --max-time 3 "http://127.0.0.1:$PORT/" 2>/dev/null)"
    if [ -n "$PI_WEB_PASSWORD" ]; then
      au="$(curl -s -o /dev/null -w '%{http_code}' --max-time 3 \
        -u "pi:$PI_WEB_PASSWORD" "http://127.0.0.1:$PORT/" 2>/dev/null)"
    else
      au="no-password-configured"
    fi
    if [ "$an" = "401" ]; then
      printf '    auth    %srequired%s  (unauth %s, with password %s)\n' "$c_ok" "$c_off" "$an" "$au"
    elif [ "$an" = "200" ]; then
      printf '    auth    %sOPEN — no password%s  (anyone who reaches this port is served)\n' "$c_bad" "$c_off"
    else
      printf '    auth    unknown (HTTP %s)\n' "$an"
    fi
  fi

  printf '    log     %s\n' "${PIWEB_LOG:-/tmp/piweb-dev.log}"
  printf '\n'
}

case "${1:-status}" in
  status|"")  status ;;

  restart)
    # --in N: detached, delayed. The only safe way for a hosted agent to do this
    # itself, because it lets the reply be delivered before the tree goes away.
    if [ "${2:-}" = "--in" ]; then
      delay="${3:-20}"
      case "$delay" in ''|*[!0-9]*) echo "  --in needs a number of seconds, e.g. --in 20" >&2; exit 2 ;; esac
      schedule_restart "$delay"
      cat <<MSG

  Restart scheduled in ${delay}s — detached, so it will complete even though this
  conversation is about to drop.

  Expect the page to stop responding, then come back on its own. Reopen or
  reload it in about $((delay + 10))s, and the session will still be there.

MSG
      exit 0
    fi
    [ -x "$REPO/scripts/piweb-restart.sh" ] || { echo "  missing $REPO/scripts/piweb-restart.sh" >&2; exit 1; }
    refuse_if_hosted restart "${2:-}" || exit 1
    "$REPO/scripts/piweb-restart.sh"
    ;;

  amihosted)
    if hosted_by_server; then
      echo "  yes — running inside pi-web (next-server pid $(port_pid))"
      echo "  'piweb restart' from here will kill this session. Use 'restart --in N'."
      exit 0
    else
      echo "  no — not a descendant of the running server"
      exit 1
    fi
    ;;

  pending)
    # A scheduled restart is a detached process; without this, one set hours out
    # is invisible until the server abruptly dies.
    pids="$(sleeper_pids)"
    if [ -z "$pids" ]; then
      echo "  no restart scheduled"
      exit 1
    fi
    echo "  scheduled restarts:"
    for p in $pids; do
      delay="$(ps -o command= -p "$p" 2>/dev/null | awk '{print $NF}')"
      printf '    pid %-7s fires in %ss\n' "$p" "$delay"
    done
    echo "  cancel with: piweb cancel"
    ;;

  cancel)
    pids="$(sleeper_pids)"
    if [ -z "$pids" ]; then echo "  nothing to cancel"; exit 1; fi
    n=0
    for p in $pids; do kill "$p" 2>/dev/null && n=$((n + 1)); done
    sleep 1
    left="$(sleeper_pids | wc -l | tr -d ' ')"
    echo "  cancelled ${n} scheduled restart(s); remaining: ${left}"
    ;;

  start)
    if running; then echo "  already running (pid $(pid_of))"; exit 0; fi
    [ -f "$PLIST" ] || { echo "  missing $PLIST" >&2; exit 1; }
    launchctl bootstrap "$DOMAIN" "$PLIST" && sleep 2 && status
    ;;

  stop)
    refuse_if_hosted stop "${2:-}" || exit 1
    if ! running; then echo "  already stopped"; exit 0; fi
    launchctl bootout "$TARGET" && echo "  stopped."
    echo "  ${c_bad}note${c_off}: auth comes from the supervisor. A server started by hand"
    echo "        without $ENV_FILE will serve with NO password."
    ;;

  logs)
    tail -n 40 -f "${PIWEB_LOG:-/tmp/piweb-dev.log}"
    ;;

  open)
    open "http://127.0.0.1:$PORT/"
    ;;

  help|-h|--help)
    cat <<'MSG'

  piweb — manage the pi-web server

    piweb                    status (default)
    piweb restart            restart (refuses from inside the server; see below)
    piweb restart --in 20    restart in 20s, detached — safe from inside
    piweb pending            show a scheduled restart
    piweb cancel             cancel a scheduled restart without restarting
    piweb start              start
    piweb stop               stop
    piweb logs               follow the server log
    piweb open               open in a browser
    piweb amihosted          am I running inside the server?

  The server is managed by launchd + a supervisor loop, so 'kill it and start it
  again' is the one thing that does not work: killing it from inside a pi-web
  session kills that session too. When hosted, use 'restart --in N' (announce it
  first) or run the command from a Terminal window.

MSG
    ;;

  *)
    echo "  unknown: $1" >&2
    echo "  try: piweb [status|restart|restart --in N|pending|cancel|start|stop|logs|open|amihosted]" >&2
    exit 2
    ;;
esac
